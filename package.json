{
  "name": "@absolutejs/maintenance",
  "version": "0.1.0",
  "description": "Explicit maintenance and developer holds with safe public responses and audited transitions.",
  "type": "module",
  "license": "BSL-1.1",
  "author": "Alex Kahn",
  "repository": {"type":"git","url":"https://github.com/absolutejs/maintenance.git"},
  "publishConfig": {"access":"public"},
  "main":"./dist/index.js",
  "types":"./dist/index.d.ts",
  "exports":{".":{"types":"./dist/index.d.ts","import":"./dist/index.js"}},
